{
  "name": "niteo-cli",
  "version": "0.1.2",
  "description": "Standalone Rust CLI for TypeScript structural linting.",
  "keywords": [
    "typescript",
    "lint",
    "linter",
    "structural-linting",
    "cli",
    "rust",
    "static-analysis",
    "oxc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrozenProductions/Niteo"
  },
  "private": false,
  "bin": {
    "niteo": "bin/niteo.js"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node ./scripts/build-binary.js",
    "build:binary": "cargo build --release",
    "check": "cargo check",
    "test": "cargo test"
  },
  "engines": {
    "node": ">=18"
  }
}
